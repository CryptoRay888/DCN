{
  "name": "dcn",
  "version": "1.0.0",
  "description": "Decentralized Compute & Network Infrastructure with Ring 24/7 Sentinel and ZK verification",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:contracts",
    "build:prod": "tsc --sourceMap false && npm run build:contracts",
    "build:contracts": "hardhat compile",
    "dev": "ts-node-dev --respawn src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:contracts": "hardhat test",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "decentralized",
    "compute",
    "network",
    "blockchain",
    "zero-knowledge",
    "verification",
    "sentinel"
  ],
  "author": "CryptoRay888",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.9.0",
    "web3": "^4.1.0",
    "@libp2p/core": "^1.1.0",
    "@libp2p/kad-dht": "^12.0.0",
    "@libp2p/mplex": "^9.0.0",
    "@libp2p/noise": "^13.0.0",
    "@libp2p/tcp": "^9.0.0",
    "@libp2p/websockets": "^7.0.0",
    "snarkjs": "^0.7.0",
    "circomlib": "^2.0.5",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "ioredis": "^5.3.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "hardhat": "^2.19.2",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
