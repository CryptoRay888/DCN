# Network Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Blockchain Configuration
RPC_URL=http://localhost:8545
CHAIN_ID=1
PRIVATE_KEY=your_private_key_here
NETWORK=localhost

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dcn
REDIS_URL=redis://localhost:6379

# Sentinel Configuration
SENTINEL_RING_SIZE=5
SENTINEL_HEARTBEAT_INTERVAL=60000
VERIFICATION_TIMEOUT=30000

# ZK Proof Configuration
ZK_CIRCUIT_PATH=./zk/circuits
ZK_PROVING_KEY_PATH=./zk/keys
ZK_VERIFICATION_ENABLED=true

# API Configuration
API_KEY=your_api_key_here
CORS_ORIGIN=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here
